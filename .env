CHANNEL_USERNAME=@TRADER_STM0
CHANNEL_NAME=TRADER STM
# Optional: private invite link if the channel has no public username
CHANNEL_INVITE_URL=

# Numeric Telegram user IDs allowed to use admin commands (comma separated). Ask @userinfobot for yours.
ADMIN_IDS=5999579884
ADMIN_USERNAME=stm_00
FEEDBACK_CONTACT=@your_feedback_username
REFERRAL_URL=https://example.com/your-referral-link

# Signal rules
MIN_PAYOUT=80
TIMEZONE=Asia/Dhaka
SCAN_INTERVAL_SECONDS=60
SIGNAL_LEAD_SECONDS=5
# closed = only fully closed candles (safe). provisional = use the forming candle at T-5s (fresher, can change).
CANDLE_MODE=closed
MIN_CONFIDENCE=50
MAX_SIGNALS_PER_CYCLE=1
ENABLED_STRATEGIES=AI,STM_PVIP,STM_PVIP2,BLACK4X,OPX4O
# RANDOM is experimental / test only
ENABLE_RANDOM=false

# Risk policy
MTG_ENABLED=true
LOSS_STREAK_LIMIT=2
COOLDOWN_HOURS=6

# Strategy tuning
PVIP_RUN=3
PVIP2_BODY_MIN=0.55
PVIP2_BODY_MAX=0.85
PVIP2_CAP_ENABLED=true
DOJI_THRESHOLD=0.10

# Membership gate
REQUIRE_MEMBERSHIP=true
# If the membership check cannot run (bot lacks rights), false = deny, true = allow
MEMBERSHIP_FAIL_OPEN=false
SHOW_INTERSTITIAL=true
LANGUAGE=both
SUMMARY_TIME=23:55
ADMIN_STOP_COMMAND=STMOP

# Storage / runtime
DATABASE_PATH=stm_pro_bot.db
CONCURRENCY=5
RATE_LIMIT_PER_SEC=8
LOG_LEVEL=INFO

# Data provider: mock (synthetic, for testing) or quotex (unofficial pyquotex, untested live)
PROVIDER=mock
# Prefer deployment secrets or leave blank - if blank and run in a terminal you are asked at start (password hidden).
