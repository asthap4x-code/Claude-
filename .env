# ===== STM PRO BOT configuration (copy to .env, never commit .env) =====
# All values below are PLACEHOLDERS. Get the token from @BotFather.
BOT_TOKEN=8438883048:AAGlab1-hVIkHee4QqM51N25mEYK5WGqpzI

# Channel users must join. The bot must be an ADMIN of this channel for getChatMember to work.
